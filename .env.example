# ============================================================
# WorkLane — Production Environment Variables
# ============================================================

# Flask Secret Key for Session Signing & Cookie Security
SECRET_KEY=worklane_production_secret_key_982347981234

# ============================================================
# Google OAuth 2.0 Credentials
# Get them from https://console.cloud.google.com/apis/credentials
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorized Redirect URI (Defaults to http://127.0.0.1:5001/auth/google/callback)
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback
